nuva:VAC0552 a owl:Class ;
    rdfs:label "DTPCaHibHepB hexavalenter Impfstoff - Diphtherie-Tetanus-Polio-zelluläre Keuchhusten-Hib-HepB, nicht spezifiziert"@de,
        "DTaPHibHepBIPV hexavalent vaccine, unspecified"@el,
        "Hexavalent vaccine DTPCaHibHepB - Diphtheria-Tetanus-Polio-Acellular Pertussis-Hib-HepB, unspecified"@en,
        "Vaccin hexavalent DTPCaHibHepB - Diphtérie-Tétanos-Polio-Coqueluche acellulaire -Hib-Hépatite B, sans précision"@fr,
        "DTaPHibHepBIPV hexavalent vaccine, unspecified"@lv,
        "DTaPHibHepBIPV hexavalent vaccine, unspecified"@pl,
        "DTaPHibHepBIPV hexavalent vaccine, unspecified"@pt ;
    nuvs:containsValence nuva:VAL008,
        nuva:VAL056,
        nuva:VAL067,
        nuva:VAL097,
        nuva:VAL103,
        nuva:VAL114 ;
    nuvs:isAbstract true ;
    dcterms:created "2021-07-19"^^xsd:date ;
    dcterms:modified "2025-05-20"^^xsd:date ;
    rdfs:comment "Diphtherietoxoid (Standarddosis), Tetanustoxoid, azellulärer Mehrkomponentenimpfstoff gegen Keuchhusten (Standarddosis), Haemophilus influenzae Typ b (konjugiert, nicht spezifiziert), inaktivierter Polioimpfstoff (dreiwertig) und Hepatitis-B-Impfstoff (rekombinant) für Kinder"@de,
        "Τοξοειδές διφθερίτιδας (τυπική δόση), τοξοειδές τετάνου, πολυσυσύνθετο ακανθώδες κοκκύτη (τυπική δόση), Haemophilus influenzae τύπου β (συζευγμένο ακαθόριστο), αδρανοποιημένη πολιομυελίτιδα (τρισθενές) και παιδιατρικό εμβόλιο ηπατίτιδας Β (ανασυνδυασμένο)."@el,
        "Diphtheria toxoid (standard dose), tetanus toxoid, pertussis (multicomponent acellular, standard dose), Haemophilus influenzae type b (conjugated, unspecified), inactivated polio (trivalent) and hepatitis B (recombinant) pediatric vaccine"@en,
        "Vaccin pédiatrique diphtérique (anatoxine, dose standard), tétanique (anatoxine), coquelucheux (acellulaire multicomposé, dose standard), poliomyélitique (entier inactivé, trivalent), anti-Haemophilus influenzae type b (conjugué, sans précision) et de l'hépatite B (recombinant)"@fr,
        "Difterijas toksoīda (standarta deva), stingumkrampju toksoīda, daudzkomponentu acelulārās garo klepusas (standarta deva), Haemophilus influenzae b tipa (konjugētas, neprecizētas), inaktivētas poliomielīta (trīsvērtīgas) un B hepatīta (rekombinantās) bērnu vakcīnas."@lv,
        "Toksoid błoniczy (dawka standardowa), toksoid tężcowy, wielokomponentowa acelularna szczepionka przeciw krztuścowi (dawka standardowa), Haemophilus influenzae typu b (skoniugowana nieokreślona), inaktywowana szczepionka przeciw polio (trójwartościowa) i szczepionka przeciw wirusowemu zapaleniu wątroby typu B (rekombinowana) dla dzieci"@pl,
        "Difteria toxoide (dose padrão), tetano toxoide, tosse convulsa acelular multicomponente (dose padrão), Haemophilus influenzae tipo b (conjugado não especificado), poliomielite inactivada (trivalente) e hepatite B (recombinante) vacina pediátrica"@pt ;
    rdfs:subClassOf nuva:Vaccine ;
    skos:notation "J07CA09"^^nuva:ATC,
