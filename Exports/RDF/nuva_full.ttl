nuva:VAC0596 a owl:Class ;
    rdfs:label "DTaPHibHepB pentavalent vaccine, unspecified"@de,
        "DTaPHibHepB pentavalent vaccine, unspecified"@el,
        "DTaPHibHepB pentavalent vaccine, unspecified"@en,
        "Vaccin pentavalent DTCaHibHepB - Diphtérie-Tétanos-Coqueluche-Hib-Hépatite B, sans précision"@fr,
        "DTaPHibHepB pentavalent vaccine, unspecified"@lv,
        "DTaPHibHepB pentavalent vaccine, unspecified"@pl,
        "DTaPHibHepB pentavalent vaccine, unspecified"@pt ;
    nuvs:containsValence nuva:VAL008,
        nuva:VAL067,
        nuva:VAL097,
        nuva:VAL103,
        nuva:VAL114 ;
    dcterms:created "2021-07-19"^^xsd:date ;
    dcterms:modified "2025-05-20"^^xsd:date ;
    rdfs:comment "Diphtherietoxoid (Standarddosis), Tetanustoxoid und azellulärer Multikomponenten-Pertussisimpfstoff (Standarddosis), Haemophilus influenzae Typ b (konjugiert, nicht spezifiziert) und Hepatitis B (rekombinant), Impfstoff für Kinder"@de,
        "Παιδιατρικό εμβόλιο διφθερίτιδας (τυπική δόση), τοξοειδούς τετάνου και πολυδύναμου κυτταρικού κοκκύτη (τυπική δόση), Haemophilus influenzae τύπου β (συζευγμένο, μη καθορισμένο) και ηπατίτιδας Β (ανασυνδυασμένο)"@el,
        "Diphtheria toxoid (standard dose), tetanus toxoid and pertussis (multicomponent acellular, standard dose), Haemophilus influenzae type b (conjugated, unspecified) and hepatitis B (recombinant) pediatric vaccine"@en,
        "Vaccin pédiatrique diphtérique (anatoxine, dose standard), tétanique (anatoxine), coquelucheux (acellulaire multicomposé, dose standard), anti-Haemophilus influenzae type b (conjugué, sans précision) et de l'hépatite B (recombinant)"@fr,
        "Difterijas toksoīda (standarta deva), stingumkrampju toksoīda un daudzkomponentu akcelulārās garo klepusas (standarta deva), Haemophilus influenzae b tipa (konjugētā, neprecizētā) un B hepatīta (rekombinētā) bērnu vakcīna"@lv,
        "Toksoid błoniczy (dawka standardowa), toksoid tężcowy i wielokomponentowy acelularny krztusiec (dawka standardowa), Haemophilus influenzae typu b (skoniugowana, nieokreślona) oraz szczepionka pediatryczna przeciwko wirusowemu zapaleniu wątroby typu B (rekombinowana)"@pl,
        "Difteria toxoide (dose padrão), tetano toxoide e tosse convulsa acelular multicomponente (dose padrão), Haemophilus influenzae tipo b (conjugado, não especificado) e vacina pediátrica contra hepatite B (recombinante)"@pt ;
    rdfs:subClassOf nuva:Vaccine ;
    skos:notation "0596"^^nuva:NUVACode,
        "0591000087106"^^<http://ivci.org/NUVA/﻿CVC>,
        "231002000106"^^<http://ivci.org/NUVA/﻿SCT_NUVA>,
        "081000221102"^^<http://ivci.org/NUVA/﻿SNOMED-CT>,
        "VAC0596"^^xsd:string .

nuva:VAC0598 a owl:Class ;
    rdfs:label "DTwPHibHepB pentavalent vaccine, unspecified"@de,
        "DTwPHibHepB pentavalent vaccine, unspecified"@el,
        "DTwPHibHepB pentavalent vaccine, unspecified"@en,
        "Vaccin pentavalent DTCeHibHepB - Diphtérie-Tétanos-Coqueluche-Hib-Hépatite B, sans précision"@fr,
        "DTwPHibHepB pentavalent vaccine, unspecified"@lv,
        "DTwPHibHepB pentavalent vaccine, unspecified"@pl,
